# Copy this file to .env on the server and fill in real values.
# .env is excluded from version control. Never put these secrets in frontend files.
ESS_STORE_BACKEND=woocommerce
ESS_WC_SITE_URL=https://wordpress.example.com
ESS_WC_CONSUMER_KEY=ck_replace_with_your_key
ESS_WC_CONSUMER_SECRET=cs_replace_with_your_secret
# Use the same random value in wp-config.php as ESS_WC_HANDOFF_SECRET; never expose it.
ESS_WC_HANDOFF_SECRET=generate_a_unique_secret_of_at_least_32_characters
ESS_STORE_PHONE=+221777477778
ESS_STORE_CURRENCY=FCFA
ESS_STORE_BRAND=ELMANSOUR SUPPLIES & SERVICES

# Optional when running the separate legacy SQLite management interface:
# ESS_PUBLIC_MODE=1
# ESS_ADMIN_PASSWORD=replace-with-a-long-unique-password
# PORT=8000
